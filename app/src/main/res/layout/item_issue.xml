<?xml version="1.0" encoding="utf-8"?>
<!-- One needs-action row: marker + sentence, then its button (and the guide link for battery). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_issue_marker"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="@drawable/status_dot"
            android:backgroundTint="@color/state_attention"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/text_issue"
            style="@style/Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginStart="@dimen/spacing_md">

        <Button
            android:id="@+id/btn_issue_action"
            style="@style/Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Takes the leftover width so it wraps at large font sizes instead of being clipped. -->
        <Button
            android:id="@+id/btn_issue_link"
            style="@style/Button.Link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:gravity="start|center_vertical"
            android:text="后台设置教程"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
